<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thêm Sách Mới - CloudBooks Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --emerald: #059669;
      --emerald-light: #ecfdf5;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-400: #94a3b8;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --slate-900: #0f172a;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #f8fafc;
      color: var(--slate-800);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Navigation Bar */
    .navbar {
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
      color: #fff;
      padding: 0.85rem 1.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
    }
    .brand-title {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }
    .back-link:hover {
      color: #fff;
    }

    /* Form Container */
    .container {
      max-width: 660px;
      width: 100%;
      margin: 2.25rem auto;
      padding: 0 1.25rem;
      flex: 1;
    }

    .form-card {
      background: #fff;
      border-radius: 20px;
      border: 1px solid var(--slate-200);
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.02);
      padding: 2.25rem;
    }

    .form-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--slate-100);
    }
    .form-title {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--slate-900);
      letter-spacing: -0.02em;
      margin-bottom: 0.35rem;
    }
    .form-desc {
      font-size: 0.88rem;
      color: var(--slate-500);
    }

    /* Alert */
    .alert-error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      border-radius: 12px;
      padding: 0.85rem 1.15rem;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 500;
    }

    /* Exam Personalization Rule Banner */
    .rule-box {
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
      border: 1.5px solid #86efac;
      border-radius: 14px;
      padding: 1.1rem 1.25rem;
      margin-bottom: 1.65rem;
      display: flex;
      gap: 0.85rem;
      align-items: flex-start;
      box-shadow: 0 2px 6px rgba(16, 185, 129, 0.08);
    }
    .rule-box-icon {
      color: #059669;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .rule-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: #065f46;
      margin-bottom: 0.35rem;
      letter-spacing: -0.01em;
    }
    .rule-desc {
      font-size: 0.84rem;
      color: #047857;
      line-height: 1.55;
    }
    .rule-desc strong {
      color: #064e3b;
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 1.35rem;
    }
    .label-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.45rem;
    }
    label {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--slate-700);
    }
    .status-pill {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
      display: none;
    }
    .pill-valid {
      display: inline-block;
      background: #ecfdf5;
      color: #059669;
      border: 1px solid #a7f3d0;
    }
    .pill-invalid {
      display: inline-block;
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
      font-family: inherit;
      border-radius: 10px;
      border: 1.5px solid var(--slate-200);
      background: #fff;
      color: var(--slate-900);
      outline: none;
      transition: all 0.15s ease;
    }
    input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }
    .code-input {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 600;
      letter-spacing: 0.05em;
    }
    .input-hint {
      font-size: 0.78rem;
      color: var(--slate-500);
      margin-top: 0.35rem;
    }

    /* Dynamic VAT Calculation Card */
    .calc-card {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.75rem;
    }
    .calc-header {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
      color: var(--slate-500);
      margin-bottom: 0.5rem;
      display: flex;
      justify-content: space-between;
    }
    .calc-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
    }
    .calc-row.final {
      margin-top: 0.6rem;
      padding-top: 0.6rem;
      border-top: 1px solid var(--slate-200);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--emerald);
    }

    /* Buttons */
    .button-group {
      display: flex;
      gap: 0.85rem;
      margin-top: 1.75rem;
    }
    .btn-submit {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      color: #fff;
      border: none;
      padding: 0.85rem 1.5rem;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
      transition: all 0.2s ease;
    }
    .btn-submit:hover {
      background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
      box-shadow: 0 6px 16px rgba(79, 70, 229, 0.4);
      transform: translateY(-1px);
    }
    .btn-cancel {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--slate-100);
      color: var(--slate-700);
      text-decoration: none;
      padding: 0.85rem 1.25rem;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 600;
      transition: all 0.15s ease;
    }
    .btn-cancel:hover {
      background: var(--slate-200);
      color: var(--slate-900);
    }

    /* Footer */
    footer {
      background: #0f172a;
      color: #94a3b8;
      border-top: 1px solid #1e293b;
      padding: 1.5rem 1.25rem;
      margin-top: auto;
    }
    .footer-inner {
      max-width: 660px;
      margin: 0 auto;
      text-align: center;
      font-size: 0.88rem;
      color: #cbd5e1;
    }
    .footer-inner strong {
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- Top Navigation Bar -->
  <nav class="navbar">
    <div class="brand-group">
      <div class="brand-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
      </div>
      <div>
        <div class="brand-title">CloudBooks Manager</div>
      </div>
    </div>
    <a href="/books" class="back-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Quay lại danh sách
    </a>
  </nav>

  <!-- Main Container -->
  <main class="container">
    <div class="form-card">
      <div class="form-header">
        <h1 class="form-title">Thêm Sách Mới</h1>
        <p class="form-desc">Dữ liệu sẽ được ghi trực tiếp vào cơ sở dữ liệu phân tán MongoDB Atlas.</p>
      </div>

      {{#if error}}
        <div class="alert-error">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span>{{error}}</span>
        </div>
      {{/if}}

      <!-- Exam Personalization Rule Banner -->
      <div class="rule-box">
        <div class="rule-box-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <div>
          <div class="rule-title">Thuật toán cá nhân hóa (Theo đề bài kiểm tra):</div>
          <div class="rule-desc">
            • <strong>Bộ lọc mã sản phẩm</strong>: Bắt buộc có tiền tố là 3 số cuối MSSV (<strong>102</strong>), nếu sai hệ thống sẽ <strong>từ chối xử lý</strong>.<br>
            • <strong>Thuế suất VAT</strong>: Tính động theo công thức: <strong>VAT = (Chữ số cuối MSSV + 5)%</strong> = (2 + 5)% = <strong>{{vatRate}}%</strong>.<br>
            • <strong>Giá sau thuế</strong>: Hệ thống tự động tính giá sau thuế trước khi lưu xuống đám mây MongoDB Atlas.
          </div>
        </div>
      </div>

      <form method="post" action="/books" id="addBookForm">
        <div class="form-group">
          <div class="label-row">
            <label for="productCode">Mã sản phẩm *</label>
            <span id="prefixStatus" class="status-pill"></span>
          </div>
          <input id="productCode" name="productCode" class="code-input" placeholder="Ví dụ: 102001, 102ABC" required value="{{oldData.productCode}}">
          <div class="input-hint">Tiền tố bắt buộc: <strong>102</strong> (3 số cuối MSSV {{mssv}}).</div>
        </div>

        <div class="form-group">
          <label for="title">Tên sách *</label>
          <input id="title" name="title" placeholder="Nhập tên sách..." required value="{{oldData.title}}">
        </div>

        <div class="form-group">
          <label for="author">Tác giả *</label>
          <input id="author" name="author" placeholder="Nhập tên tác giả..." required value="{{oldData.author}}">
        </div>

        <div class="form-group">
          <label for="priceBeforeTax">Giá trước thuế (VND) *</label>
          <input id="priceBeforeTax" name="priceBeforeTax" type="number" min="0" step="any" placeholder="Ví dụ: 150000" required value="{{oldData.priceBeforeTax}}">
        </div>

        <!-- Live VAT Calculator Box -->
        <div class="calc-card">
          <div class="calc-header">
            <span>Bảng tính thuế tự động</span>
            <span>VAT: ({{mssv}} đuôi 2 + 5)% = {{vatRate}}%</span>
          </div>
          <div class="calc-row">
            <span style="color: var(--slate-600);">Giá gốc (Trước thuế):</span>
            <span id="calcBase" style="font-weight: 600;">0 ₫</span>
          </div>
          <div class="calc-row">
            <span style="color: var(--slate-600);">Thuế VAT động ({{vatRate}}%):</span>
            <span id="calcVat" style="font-weight: 600; color: #6366f1;">+0 ₫</span>
          </div>
          <div class="calc-row final">
            <span>Giá sau thuế (Lưu xuống MongoDB Cloud):</span>
            <span id="calcTotal">0 ₫</span>
          </div>
        </div>

        <div class="button-group">
          <button type="submit" class="btn-submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Lưu Sách Lên Cloud
          </button>
          <a href="/books" class="btn-cancel">Hủy bỏ</a>
        </div>
      </form>
    </div>
  </main>

  <!-- Required Exam Footer -->
  <footer>
    <div class="footer-inner">
      Họ tên: <strong>{{fullName}}</strong> | MSSV: <strong>{{mssv}}</strong> | Lớp: <strong>{{className}}</strong> | Mức VAT áp dụng: <strong>{{vatRate}}%</strong>
    </div>
  </footer>

  <script>
    const vatRate = Number('{{vatRate}}') || 7;
    const prefix = '102';

    // Live Product Code prefix check
    const codeInput = document.getElementById('productCode');
    const prefixStatus = document.getElementById('prefixStatus');

    function checkPrefix() {
      const val = codeInput.value.trim();
      if (!val) {
        prefixStatus.style.display = 'none';
        return;
      }
      if (val.startsWith(prefix)) {
        prefixStatus.textContent = '✓ Tiền tố 102 hợp lệ';
        prefixStatus.className = 'status-pill pill-valid';
      } else {
        prefixStatus.textContent = '✕ Tiền tố phải là 102 (Hệ thống sẽ từ chối)';
        prefixStatus.className = 'status-pill pill-invalid';
      }
    }
    codeInput.addEventListener('input', checkPrefix);
    checkPrefix();

    // Live VAT Calculation
    const priceInput = document.getElementById('priceBeforeTax');
    const calcBase = document.getElementById('calcBase');
    const calcVat = document.getElementById('calcVat');
    const calcTotal = document.getElementById('calcTotal');

    function updateCalc() {
      const base = Number(priceInput.value) || 0;
      const vat = base * (vatRate / 100);
      const total = base + vat;

      calcBase.textContent = base.toLocaleString('vi-VN') + ' ₫';
      calcVat.textContent = '+' + Math.round(vat).toLocaleString('vi-VN') + ' ₫';
      calcTotal.textContent = Math.round(total).toLocaleString('vi-VN') + ' ₫';
    }

    priceInput.addEventListener('input', updateCalc);
    updateCalc();
  </script>
</body>
</html>
